# Copy to .env and fill in what you have. Every value here is optional --
# the app boots and serves without any of them (app/runtime/capabilities.py
# reports honestly on what's missing via GET /v1/runtime/readiness rather
# than failing to start).

# --- Provider credentials (app/providers/auth.py) ---
# Configuring any of these enables that provider for live generation.
# None configured means no live provider generation is possible; the app
# still runs for planning, QA, scene/world/render local work.
TRIPO_API_KEY=
MESHY_API_KEY=
HI3D_API_KEY=

# --- Local image-to-video studio (app/video) ---
# Heavy inference stays on the owner's machine. These settings do not add
# a paid/cloud generation fallback and contain no secrets.
CHARACTER3D_VIDEO_ENABLED=1
CHARACTER3D_VIDEO_MODEL_DIR=./weights/video
CHARACTER3D_VIDEO_OUTPUT_DIR=
CHARACTER3D_VIDEO_PRIVACY_DEFAULT=1
CHARACTER3D_VIDEO_IDLE_LOCK_SECONDS=30
CHARACTER3D_VIDEO_QUICK_HIDE_ENABLED=1
CHARACTER3D_VIDEO_REQUIRE_UNLOCK_ON_RESUME=1

# --- Local FLUX 3 Image Klein editing (app/image) ---
# The high-VRAM reference runner stays available for large GPUs. On 8 GB-class
# NVIDIA GPUs, the preferred path is the official ComfyUI int8 workflow.
# scripts/windows/setup-private-media.ps1 installs the pinned runtime/workflow.
CHARACTER3D_COMFY_HOME=./vendor/ComfyUI
CHARACTER3D_COMFY_CLI=./vendor/ComfyUI/.venv/Scripts/comfy.exe
CHARACTER3D_COMFY_WORKFLOW=./vendor/workflows/image_flux3_klein_distilled_image_edit.json
CHARACTER3D_COMFY_HOST=127.0.0.1
CHARACTER3D_COMFY_PORT=8188
CHARACTER3D_COMFY_TIMEOUT_SECONDS=3600

# Optional high-VRAM direct FLUX reference runner. Leave unset on an 8 GB GPU.
CHARACTER3D_FLUX_REPO=./vendor/flux-3-image-klein
CHARACTER3D_FLUX_WEIGHTS_DIR=./vendor/flux-3-image-klein/weights
CHARACTER3D_FLUX_PYTHON=
CHARACTER3D_FLUX_TIMEOUT_SECONDS=1800

# --- Private browser studio ---
# Remote API access requires a token unless the reverse proxy presents the
# request as loopback. The Windows launcher generates/stores one under the
# ignored workspace/studio directory rather than committing it.
CHARACTER3D_STUDIO_TOKEN=
CHARACTER3D_STUDIO_ORIGINS=
CHARACTER3D_STUDIO_WORKSPACE=./workspace/studio

# --- Pinned local LTX-2.5 runtime (app/video/adapters/ltx25.py) ---
# LTX-2.5 runs in a separate Python environment so its large CUDA/PyTorch
# dependency stack and 22B model weights never load into the FastAPI process.
# Install ltx-pipelines 1.5.0 from pinned source revision
# e98f6d927d83c92ef2be6aec76c8440b19306e39, then point this at that venv.
# Generation is local/offline and does not require an inference API key.
CHARACTER3D_LTX_PYTHON=
CHARACTER3D_LTX_MODEL_DIR=./weights/video/ltx-2.5
CHARACTER3D_LTX_OFFLOAD=disk
# Optional: fp8-cast or fp8-scaled-mm after verifying support on the target GPU.
CHARACTER3D_LTX_QUANTIZATION=
CHARACTER3D_LTX_TIMEOUT_SECONDS=3600

# --- Local database paths (app/main.py) ---
# All default to ./workspace/*.db if unset; override for a different
# workspace location or a persistent volume mount in a container.
CHARACTER3D_LEASE_DB=./workspace/runtime_leases.db
CHARACTER3D_CLAIM_DB=./workspace/job_claims.db
CHARACTER3D_LINEAGE_DB=./workspace/artifact_lineage.db
CHARACTER3D_CHECKPOINT_DB=./workspace/stage_checkpoints.db

# --- Source root override (app/main.py::_source_root) ---
# Used by GET /v1/release/build-fingerprint. Defaults to the repo root;
# override only if the deployed source tree lives somewhere else.
# CHARACTER3D_SOURCE_ROOT=

# --- Blender (app/workers/blender.py) ---
# Path to the Blender executable for Blender-worker stages (repair, bake,
# export, animation). Falls back to `which blender` if unset. Neither this
# environment nor CI has Blender installed -- Blender-dependent stages are
# implemented and tested against their own contracts, but no live Blender
# execution has occurred in this repository (see docs/V10_EXECUTION_TRUTH.md).
# BLENDER_BIN=/usr/bin/blender
